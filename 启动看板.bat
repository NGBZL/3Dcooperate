@echo off
chcp 65001 >nul
title 组内看板（关掉这个窗口 = 停止服务）
cd /d "%~dp0"

echo ============================================================
echo   组内看板服务
echo ------------------------------------------------------------
echo   * 这个窗口要一直开着（最小化就行），关掉窗口服务就停了
echo   * 局域网地址会打印在下面（页面顶部也能看到、可一键复制）
echo   * 停止服务：在这个窗口按 Ctrl + C，或直接关窗口
echo   * 已经关了自动重载，改代码后请重新双击本文件启动
echo ============================================================
echo.

where py >nul 2>nul
if %errorlevel%==0 (
    py -3.14 server.py --no-reload
) else (
    python server.py --no-reload
)

echo.
echo ============================================================
echo   服务已退出（退出码 %errorlevel%）
echo   常见原因：
echo     - 端口 5000 被别的程序占用（先把旧的关掉）
echo     - 上面打印了报错，按报错处理
echo   把上面的信息截图发出来即可。
echo ============================================================
pause
