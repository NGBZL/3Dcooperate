# ============================================================
# Agent 代码审核 · 配置模板
# ------------------------------------------------------------
# 复制本文件为 agent/.env，填入你的 DeepSeek API Key 即可。
# agent/.env 已被 .gitignore 忽略，不会被提交到仓库。
#
#   copy agent\.env.example agent\.env      (Windows)
#   cp agent/.env.example agent/.env        (macOS / Linux)
# ============================================================

# ---------- 必填：大模型 ----------
# DeepSeek 平台的 API Key，形如 sk-xxxxxxxx
LLM_API_KEY=

# 接口地址（DeepSeek 官方地址，兼容 OpenAI 协议；用 OpenAI 就换成
# https://api.openai.com/v1/chat/completions）
LLM_API_URL=https://api.deepseek.com/v1/chat/completions

# 模型名（DeepSeek：deepseek-chat 或 deepseek-reasoner；OpenAI：gpt-4o-mini 等）
LLM_MODEL=deepseek-chat

# ---------- 可选：GitHub 侧 ----------
# 本地运行时才需要。不填会自动读项目根目录 .env 里的 GITHUB_TOKEN / GITHUB_REPO。
# Token 需要 Issues: Read and write 权限（要评论、打标签、关 Issue）。
# GITHUB_TOKEN=ghp_你的token
# REPO=owner/repo

# ---------- 可选：调优 ----------
# 审核通过线（默认 70，score >= 该值才算通过）
# AGENT_PASS_SCORE=70

# 单次审核最多送给模型多少字符的 diff（默认 12000，超出会截断）
# AGENT_DIFF_MAX_CHARS=12000
# AGENT_DIFF_MAX_CHARS_PER_FILE=4000

# LLM 请求超时（秒）与重试次数
# LLM_TIMEOUT=120
# LLM_MAX_RETRIES=3
# LLM_TEMPERATURE=0.2

# 演练模式：只打印审核报告，不写 GitHub（1 打开）
# AGENT_DRY_RUN=0
