# ============================================================
# 复制本文件为 .env 并填入真实值（.env 已被 .gitignore 忽略）
# ============================================================

# GitHub Personal Access Token（Fine-grained 或 Classic 均可）
# 需要的权限：Issues: Read and write、Contents: Read、Metadata: Read
# 注意：Token 必须对**任务仓库**有上面这些权限；如果还想推送改动到仓库，
#       还需要 Contents: Read and write（以及改 workflow 时的 Workflows: Read and write）
# 要用看板上的「建分支 / 提 PR / 合并」，再补：
#       Contents: Read and write（建分支）、Pull requests: Read and write（提 PR、合并）
GITHUB_TOKEN=ghp_你的token

# 任务仓库（看板从哪个仓库同步 Issue、把任务写回哪个仓库），格式必须为 owner/repo。
#
# 本项目把「看板代码」和「任务 + 项目代码」拆成了两个仓库：
#   · 看板代码仓库：只放看板自己（server.py / static / templates / agent …）
#   · 任务仓库：  每张任务卡 = 这个仓库的一个 Issue，项目代码也提交在这里
# 所以这里填的是**任务仓库**，不是看板代码仓库。
GITHUB_REPO=你的用户名/任务仓库名

# ---------- 以下均为可选配置，不填则使用默认值 ----------

# GitHub API 地址（GitHub Enterprise 可改成自建地址）
# GITHUB_API_BASE=https://api.github.com

# SQLite 数据库文件路径（默认：项目目录下 kanban.db）
# DB_PATH=./kanban.db

# 服务监听地址与端口
# HOST=0.0.0.0
# PORT=5000
# DEBUG=true

# 是否开启自动重载（改 .py 自动重启）。开发时方便；
# 但长期跑给团队用时建议设为 0：批量改文件会连着重启好几次，中途被打断服务就没了。
# 另外命令行也能临时关掉：python server.py --no-reload
# USE_RELOADER=1

# 单次请求超时（秒）、失败重试次数、重试退避基数（秒）
# REQUEST_TIMEOUT=10
# MAX_RETRIES=3
# RETRY_BACKOFF=2

# 同步范围：all=全部 Issue（关闭的视为 done）/ open=仅未关闭
# SYNC_ISSUE_STATE=all

# 单次同步最多翻页数（每页 100 条）与分支提交查询预算
# SYNC_MAX_PAGES=5
# SYNC_BRANCH_COMMIT_BUDGET=25

# 每张卡片展示的提交条数
# COMMITS_PER_TASK=3

# 日志文件路径
# LOG_PATH=./kanban.log

# ---------- 分支 / Pull Request ----------
# 主干分支名（建分支的起点、提 PR 的 base）
# DEFAULT_BRANCH=main

# 合并方式：merge / squash / rebase
# PR_MERGE_METHOD=squash

# 单次同步最多刷新多少个 PR 的状态（保护 API 额度）
# PR_SYNC_BUDGET=25

# 提 PR 时自动写进正文的模板，{issue} 会替换成编号。
# Closes #N 会让 GitHub 在合并时自动关闭 Issue —— 这就是「合并后才进 Done」的机制
# PR_BODY_TEMPLATE=关联任务 #{issue}\n\nCloses #{issue}\n

# ---------- 卡片上的纯文本编辑器（网页直接提交代码）----------
# 单个文件上限（字节，默认 300 KB）
# CODE_MAX_FILE_BYTES=300000

# 单次提交的总大小上限（字节，默认 1 MB）
# CODE_MAX_TOTAL_BYTES=1000000

# ---------- 权限 ----------
# 是否允许所有人把任务指派给别人（默认 0）。
# 组员默认只能「认领给自己」；**组长不受这条限制**，组长用数据库里的角色控制：
#   python auth.py role <登录名> lead      # 设为组长：可给任何人分派、放行并合并 PR
#   python auth.py role <登录名> member    # 取消组长
# 把下面这行设为 1 等于「所有人都是组长」，一般不要开
# ALLOW_ASSIGN_TO_OTHERS=0

# 完成是不是终态（默认 1）：Done 的卡片谁都不能再拖出去（连组长也不行）
# DONE_IS_FINAL=1

# 是否必须等 Agent 审核通过才能进 Done（默认 1，一般不要关）
# DONE_REQUIRES_AGENT=1
